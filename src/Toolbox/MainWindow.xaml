<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Toolbox.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Toolbox.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource ToolboxPageBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FocusSearch_Invoked" />
            <KeyboardAccelerator Key="Escape" Invoked="Cancel_Invoked" />
            <KeyboardAccelerator Key="F5" Invoked="RefreshDetails_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,16" Background="{ThemeResource ToolboxLayerBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource ToolboxAccentBrush}"
                            VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock x:Name="TitleText"
                               Text="Toolbox"
                               Style="{StaticResource SectionTitleStyle}"
                               Foreground="{ThemeResource ToolboxTextPrimaryBrush}"
                               Margin="0"
                               VerticalAlignment="Center"
                               AutomationProperties.HeadingLevel="Level1" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="ThemeCombo"
                              MinWidth="120"
                              SelectionChanged="ThemeCombo_SelectionChanged"
                              ToolTipService.ToolTip="Theme"
                              AutomationProperties.Name="Theme" />
                    <Button x:Name="SettingsButton"
                            Content="Settings"
                            Click="SettingsButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <InfoBar x:Name="NoticeBar"
                 Grid.Row="1"
                 Margin="16,8,16,0"
                 IsOpen="False"
                 IsClosable="True" />

        <TabView x:Name="MainTabs"
                 Grid.Row="2"
                 Padding="8,4,8,0"
                 IsAddTabButtonVisible="False"
                 CanReorderTabs="False"
                 CanDragTabs="False"
                 Background="Transparent">
            <TabView.Resources>
                <SolidColorBrush x:Key="TabViewBackground" Color="Transparent" />
            </TabView.Resources>

            <TabViewItem Header="PC Search" IsClosable="False">
                <Grid Padding="8,12,8,8" ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="HistoryColumn" Width="200" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="HistoryPanel"
                            Grid.Column="0"
                            Padding="12"
                            CornerRadius="8"
                            Background="{ThemeResource ToolboxCardBrush}"
                            BorderBrush="{ThemeResource ToolboxCardStrokeBrush}"
                            BorderThickness="1">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock x:Name="HistoryHeader"
                                           Text="Recent searches"
                                           Style="{StaticResource MutedCaptionStyle}"
                                           Foreground="{ThemeResource ToolboxTextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <HyperlinkButton x:Name="ClearHistoryButton"
                                                 Content="Clear"
                                                 Padding="4,0"
                                                 FontSize="12"
                                                 HorizontalAlignment="Right"
                                                 Click="ClearHistoryButton_Click"
                                                 AutomationProperties.Name="Clear search history" />
                            </Grid>
                            <ListView x:Name="HistoryList"
                                      Grid.Row="1"
                                      Background="Transparent"
                                      Foreground="{ThemeResource ToolboxTextPrimaryBrush}"
                                      SelectionMode="None"
                                      IsItemClickEnabled="True"
                                      ItemClick="HistoryList_ItemClick"
                                      AutomationProperties.Name="Recent searches" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            Padding="12"
                            CornerRadius="8"
                            Background="{ThemeResource ToolboxCardBrush}"
                            BorderBrush="{ThemeResource ToolboxCardStrokeBrush}"
                            BorderThickness="1">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SearchBox"
                                         PlaceholderText="Computer name, description, or username"
                                         MaxLength="256"
                                         KeyDown="SearchBox_KeyDown"
                                         AutomationProperties.Name="Search text" />
                                <ComboBox x:Name="PresetCombo"
                                          Grid.Column="1"
                                          MinWidth="140"
                                          SelectionChanged="PresetCombo_SelectionChanged"
                                          AutomationProperties.Name="Search preset" />
                                <Button x:Name="SearchButton"
                                        Grid.Column="2"
                                        Content="Search"
                                        Style="{StaticResource ToolboxAccentButtonStyle}"
                                        Click="SearchButton_Click" />
                                <Button x:Name="CancelSearchButton"
                                        Grid.Column="2"
                                        Content="Cancel"
                                        Visibility="Collapsed"
                                        Click="CancelSearchButton_Click" />
                                <ProgressRing x:Name="SearchProgress"
                                              Grid.Column="3"
                                              Width="28"
                                              Height="28"
                                              IsActive="False"
                                              Visibility="Collapsed"
                                              AutomationProperties.Name="Searching" />
                            </Grid>

                            <Grid Grid.Row="1">
                                <TextBlock x:Name="ResultsHint"
                                           Text="Select a computer to load OS info and ping results."
                                           Style="{StaticResource MutedCaptionStyle}"
                                           Foreground="{ThemeResource ToolboxTextSecondaryBrush}" />
                                <TextBlock x:Name="ResultCountText"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource MutedCaptionStyle}"
                                           Foreground="{ThemeResource ToolboxTextSecondaryBrush}" />
                            </Grid>

                            <Grid Grid.Row="2">
                                <ListView x:Name="ResultsList"
                                          Background="Transparent"
                                          Foreground="{ThemeResource ToolboxTextPrimaryBrush}"
                                          SelectionMode="Single"
                                          SelectionChanged="ResultsList_SelectionChanged"
                                          DoubleTapped="ResultsList_DoubleTapped"
                                          KeyDown="ResultsList_KeyDown"
                                          AutomationProperties.Name="Search results">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="4,2" />
                                            <Setter Property="MinHeight" Value="36" />
                                            <Setter Property="Foreground" Value="{ThemeResource ToolboxTextPrimaryBrush}" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.Header>
                                        <Grid Padding="12,8" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="170" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Computer" FontWeight="SemiBold" Foreground="{ThemeResource ToolboxTextPrimaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="Description" FontWeight="SemiBold" Foreground="{ThemeResource ToolboxTextPrimaryBrush}" />
                                            <TextBlock Grid.Column="2" Text="Operating system" FontWeight="SemiBold" Foreground="{ThemeResource ToolboxTextPrimaryBrush}" />
                                        </Grid>
                                    </ListView.Header>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:ComputerItem">
                                            <Grid Padding="4,6" ColumnSpacing="16" AutomationProperties.Name="{x:Bind Name}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="170" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Name}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource ToolboxTextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind Description}"
                                                           Foreground="{ThemeResource ToolboxTextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{x:Bind Description}" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{x:Bind OperatingSystemDisplay}"
                                                           Foreground="{ThemeResource ToolboxTextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Name="EmptyResultsText"
                                           Text="No computers found. Try a different search."
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource MutedCaptionStyle}"
                                           Foreground="{ThemeResource ToolboxTextSecondaryBrush}"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Padding="16"
                            CornerRadius="8"
                            Background="{ThemeResource ToolboxCardBrush}"
                            BorderBrush="{ThemeResource ToolboxCardStrokeBrush}"
                            BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="4" Padding="0,0,8,0">
                                <Grid>
                                    <TextBlock Text="Details"
                                               Style="{StaticResource SectionTitleStyle}"
                                               Foreground="{ThemeResource ToolboxTextPrimaryBrush}"
                                               AutomationProperties.HeadingLevel="Level2" />
                                    <ProgressRing x:Name="DetailProgress"
                                                  Width="20"
                                                  Height="20"
                                                  HorizontalAlignment="Right"
                                                  IsActive="False"
                                                  Visibility="Collapsed"
                                                  AutomationProperties.Name="Loading details" />
                                </Grid>

                                <TextBlock Style="{StaticResource DetailLabelStyle}" Foreground="{ThemeResource ToolboxTextSecondaryBrush}" Text="Computer" />
                                <Grid ColumnSpacing="8" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DetailName"
                                               Style="{StaticResource DetailValueStyle}"
                                               Foreground="{ThemeResource ToolboxTextPrimaryBrush}"
                                               FontWeight="SemiBold"
                                               Margin="0"
                                               IsTextSelectionEnabled="True"
                                               Text="—" />
                                    <Button x:Name="CopyNameButton"
                                            Grid.Column="1"
                                            Padding="6"
                                            Click="CopyComputerName_Click"
                                            ToolTipService.ToolTip="Copy computer name"
                                            AutomationProperties.Name="Copy computer name">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                    </Button>
                                </Grid>

                                <TextBlock Style="{StaticResource DetailLabelStyle}" Foreground="{ThemeResource ToolboxTextSecondaryBrush}" Text="Directory OS" />
                                <TextBlock x:Name="DetailAdOs" Style="{StaticResource DetailValueStyle}" Foreground="{ThemeResource ToolboxTextPrimaryBrush}" Text="—" />

                                <TextBlock Style="{StaticResource DetailLabelStyle}" Foreground="{ThemeResource ToolboxTextSecondaryBrush}" Text="Last directory logon (approximate)" />
                                <TextBlock x:Name="DetailLastLogon" Style="{StaticResource DetailValueStyle}" Foreground="{ThemeResource ToolboxTextPrimaryBrush}" Text="—" />

                                <TextBlock Style="{StaticResource DetailLabelStyle}" Foreground="{ThemeResource ToolboxTextSecondaryBrush}" Text="Installed OS" />
                                <TextBlock x:Name="DetailOs" Style="{StaticResource DetailValueStyle}" Foreground="{ThemeResource ToolboxTextPrimaryBrush}" Text="—" />

                                <TextBlock Style="{StaticResource DetailLabelStyle}" Foreground="{ThemeResource ToolboxTextSecondaryBrush}" Text="OS version" />
                                <TextBlock x:Name="DetailOsVersion" Style="{StaticResource DetailValueStyle}" Foreground="{ThemeResource ToolboxTextPrimaryBrush}" Text="—" />

                                <TextBlock Style="{StaticResource DetailLabelStyle}" Foreground="{ThemeResource ToolboxTextSecondaryBrush}" Text="Last logged-on user" />
                                <TextBlock x:Name="DetailLastUser" Style="{StaticResource DetailValueStyle}" Foreground="{ThemeResource ToolboxTextPrimaryBrush}" IsTextSelectionEnabled="True" Text="—" />

                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
                                    <Grid Width="12" Height="12" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                                        <Ellipse x:Name="PingDotUnknown" Fill="{ThemeResource ToolboxSubtleFillBrush}" />
                                        <Ellipse x:Name="PingDotOnline" Fill="{ThemeResource SystemFillColorSuccessBrush}" Visibility="Collapsed" />
                                        <Ellipse x:Name="PingDotOffline" Fill="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                                    </Grid>
                                    <TextBlock x:Name="PingSummary"
                                               Text="Ping: —"
                                               Foreground="{ThemeResource ToolboxTextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <Border Height="1" Background="{ThemeResource ToolboxDividerBrush}" Margin="0,0,0,12" />

                                <TextBlock Text="Local admin password (LAPS)"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource ToolboxTextPrimaryBrush}"
                                           AutomationProperties.HeadingLevel="Level3" />
                                <TextBlock x:Name="DetailLaps"
                                           FontFamily="{StaticResource ToolboxMonoFont}"
                                           FontSize="16"
                                           Margin="0,4,0,2"
                                           Foreground="{ThemeResource ToolboxTextPrimaryBrush}"
                                           IsTextSelectionEnabled="False"
                                           Text="Not retrieved"
                                           AutomationProperties.Name="LAPS password" />
                                <TextBlock x:Name="LapsInfoText"
                                           Style="{StaticResource MutedCaptionStyle}"
                                           Foreground="{ThemeResource ToolboxTextSecondaryBrush}"
                                           TextWrapping="WrapWholeWords"
                                           Margin="0,0,0,8" />
                                <Grid ColumnSpacing="8" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="ShowLapsButton"
                                            Content="Show"
                                            HorizontalAlignment="Stretch"
                                            Click="ShowLapsButton_Click"
                                            AutomationProperties.Name="Show LAPS password" />
                                    <Button x:Name="CopyLapsButton"
                                            Grid.Column="1"
                                            Content="Copy"
                                            HorizontalAlignment="Stretch"
                                            Click="CopyLapsButton_Click"
                                            AutomationProperties.Name="Copy LAPS password" />
                                </Grid>

                                <Border Height="1" Background="{ThemeResource ToolboxDividerBrush}" Margin="0,0,0,12" />

                                <TextBlock Text="Remote tools"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource ToolboxTextPrimaryBrush}"
                                           Margin="0,0,0,8"
                                           AutomationProperties.HeadingLevel="Level3" />
                                <ComboBox x:Name="RemoteToolCombo"
                                          HorizontalAlignment="Stretch"
                                          Margin="0,0,0,8"
                                          AutomationProperties.Name="Remote tool" />
                                <Button x:Name="RemoteButton"
                                        Content="Remote in"
                                        Style="{StaticResource ToolboxAccentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Click="RemoteButton_Click"
                                        Margin="0,0,0,8" />

                                <ItemsControl x:Name="DetailActionsHost">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabViewItem>

            <TabViewItem x:Name="StreamingTab" Header="Streaming" IsClosable="False">
                <Border Margin="8,12,8,8"
                        Padding="20"
                        CornerRadius="8"
                        Background="{ThemeResource ToolboxCardBrush}"
                        BorderBrush="{ThemeResource ToolboxCardStrokeBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        MinWidth="320">
                    <StackPanel Spacing="12" MaxWidth="360">
                        <TextBlock Text="Streaming"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Foreground="{ThemeResource ToolboxTextPrimaryBrush}"
                                   AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock Text="Pick a streaming PC, then connect to it or open its web tools."
                                   Style="{StaticResource MutedCaptionStyle}"
                                   Foreground="{ThemeResource ToolboxTextSecondaryBrush}"
                                   TextWrapping="WrapWholeWords" />

                        <ComboBox x:Name="StreamingEndpointCombo"
                                  Header="Streaming PC"
                                  HorizontalAlignment="Stretch" />

                        <Button x:Name="StreamingConnectButton"
                                Content="Connect to PC"
                                Style="{StaticResource ToolboxAccentButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Click="StreamingConnectButton_Click" />
                        <Button x:Name="StreamingViewButton"
                                Content="View stream"
                                HorizontalAlignment="Stretch"
                                Click="StreamingViewButton_Click" />
                        <Button x:Name="StreamingControlButton"
                                Content="Control app"
                                HorizontalAlignment="Stretch"
                                Click="StreamingControlButton_Click" />

                        <Border Height="1" Background="{ThemeResource ToolboxDividerBrush}" Margin="0,4" />

                        <Button x:Name="StreamingAccountButton"
                                Content="Change stream password"
                                HorizontalAlignment="Stretch"
                                Click="StreamingAccountButton_Click" />
                    </StackPanel>
                </Border>
            </TabViewItem>
        </TabView>

        <Border x:Name="StatusPanel"
                Grid.Row="3"
                Padding="16,8"
                Background="{ThemeResource ToolboxLayerBrush}"
                BorderBrush="{ThemeResource ToolboxDividerBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="72" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,4" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Status"
                               Style="{StaticResource MutedCaptionStyle}"
                               Foreground="{ThemeResource ToolboxTextSecondaryBrush}" />
                    <TextBlock x:Name="LatestStatusText"
                               Grid.Column="1"
                               Style="{StaticResource MutedCaptionStyle}"
                               Foreground="{ThemeResource ToolboxTextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.LiveSetting="Polite"
                               AutomationProperties.Name="Latest status" />
                    <HyperlinkButton x:Name="OpenLogButton"
                                     Grid.Column="2"
                                     Content="Open log folder"
                                     Padding="4,0"
                                     FontSize="12"
                                     Click="OpenLogButton_Click" />
                </Grid>
                <ListView x:Name="StatusList"
                          Grid.Row="1"
                          Background="Transparent"
                          Foreground="{ThemeResource ToolboxTextSecondaryBrush}"
                          SelectionMode="None"
                          AutomationProperties.Name="Status history">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:StatusLogEntry">
                            <TextBlock Text="{x:Bind Display}"
                                       FontFamily="{StaticResource ToolboxMonoFont}"
                                       FontSize="12"
                                       Foreground="{ThemeResource ToolboxTextSecondaryBrush}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Window>
