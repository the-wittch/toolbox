<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Toolbox.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Toolbox.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource ToolboxPageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,16" Background="{ThemeResource ToolboxLayerBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource ToolboxAccentBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TitleText"
                               Text="Toolbox"
                               Style="{StaticResource SectionTitleStyle}"
                               Foreground="{ThemeResource ToolboxTextPrimaryBrush}"
                               Margin="0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="ThemeCombo"
                              MinWidth="120"
                              SelectionChanged="ThemeCombo_SelectionChanged"
                              ToolTipService.ToolTip="Theme" />
                    <Button x:Name="SettingsButton"
                            Content="Settings"
                            Click="SettingsButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <TabView x:Name="MainTabs"
                 Grid.Row="1"
                 Padding="8,4,8,0"
                 IsAddTabButtonVisible="False"
                 CanReorderTabs="False"
                 CanDragTabs="False"
                 Background="Transparent">
            <TabView.Resources>
                <SolidColorBrush x:Key="TabViewBackground" Color="Transparent" />
            </TabView.Resources>

            <TabViewItem Header="PC Search" IsClosable="False">
                <Grid Padding="8,12,8,8" ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="HistoryColumn" Width="200" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="HistoryPanel"
                            Grid.Column="0"
                            Padding="12"
                            CornerRadius="8"
                            Background="{ThemeResource ToolboxCardBrush}"
                            BorderBrush="{ThemeResource ToolboxCardStrokeBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="HistoryHeader"
                                       Text="Recent searches"
                                       Style="{StaticResource MutedCaptionStyle}"
                                       Foreground="{ThemeResource ToolboxTextSecondaryBrush}"
                                       Margin="0,0,0,8" />
                            <ListView x:Name="HistoryList"
                                      Grid.Row="1"
                                      Background="Transparent"
                                      Foreground="{ThemeResource ToolboxTextPrimaryBrush}"
                                      DoubleTapped="HistoryList_DoubleTapped"
                                      SelectionMode="Single" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            Padding="12"
                            CornerRadius="8"
                            Background="{ThemeResource ToolboxCardBrush}"
                            BorderBrush="{ThemeResource ToolboxCardStrokeBrush}"
                            BorderThickness="1">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SearchBox"
                                         PlaceholderText="Computer name, description, or username"
                                         KeyDown="SearchBox_KeyDown" />
                                <ComboBox x:Name="PresetCombo"
                                          Grid.Column="1"
                                          MinWidth="140"
                                          SelectionChanged="PresetCombo_SelectionChanged" />
                                <Button x:Name="SearchButton"
                                        Grid.Column="2"
                                        Content="Search"
                                        Style="{StaticResource ToolboxAccentButtonStyle}"
                                        Click="SearchButton_Click" />
                                <ProgressRing x:Name="SearchProgress"
                                              Grid.Column="3"
                                              Width="28"
                                              Height="28"
                                              IsActive="False"
                                              Visibility="Collapsed" />
                            </Grid>

                            <TextBlock x:Name="ResultsHint"
                                       Grid.Row="1"
                                       Text="Double-click a row for OS info and ping results."
                                       Style="{StaticResource MutedCaptionStyle}"
                                       Foreground="{ThemeResource ToolboxTextSecondaryBrush}" />

                            <Grid Grid.Row="2">
                                <ListView x:Name="ResultsList"
                                          Background="Transparent"
                                          Foreground="{ThemeResource ToolboxTextPrimaryBrush}"
                                          SelectionMode="Single"
                                          SelectionChanged="ResultsList_SelectionChanged"
                                          DoubleTapped="ResultsList_DoubleTapped"
                                          IsItemClickEnabled="True">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="4,2" />
                                            <Setter Property="MinHeight" Value="36" />
                                            <Setter Property="Foreground" Value="{ThemeResource ToolboxTextPrimaryBrush}" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.Header>
                                        <Grid Padding="12,8" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Computer"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource ToolboxTextPrimaryBrush}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="Description"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource ToolboxTextPrimaryBrush}" />
                                        </Grid>
                                    </ListView.Header>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:ComputerItem">
                                            <Grid Padding="4,6" ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Name}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource ToolboxTextPrimaryBrush}"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind Description}"
                                                           Foreground="{ThemeResource ToolboxTextSecondaryBrush}"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Name="EmptyResultsText"
                                           Text="No computers found. Try a different search."
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource MutedCaptionStyle}"
                                           Foreground="{ThemeResource ToolboxTextSecondaryBrush}"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Padding="16"
                            CornerRadius="8"
                            Background="{ThemeResource ToolboxCardBrush}"
                            BorderBrush="{ThemeResource ToolboxCardStrokeBrush}"
                            BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Details"
                                           Style="{StaticResource SectionTitleStyle}"
                                           Foreground="{ThemeResource ToolboxTextPrimaryBrush}" />
                                <TextBlock Style="{StaticResource DetailLabelStyle}"
                                           Foreground="{ThemeResource ToolboxTextSecondaryBrush}"
                                           Text="Computer" />
                                <TextBlock x:Name="DetailName"
                                           Style="{StaticResource DetailValueStyle}"
                                           Foreground="{ThemeResource ToolboxTextPrimaryBrush}"
                                           Text="—" />

                                <TextBlock Style="{StaticResource DetailLabelStyle}"
                                           Foreground="{ThemeResource ToolboxTextSecondaryBrush}"
                                           Text="Operating system" />
                                <TextBlock x:Name="DetailOs"
                                           Style="{StaticResource DetailValueStyle}"
                                           Foreground="{ThemeResource ToolboxTextPrimaryBrush}"
                                           Text="—" />

                                <TextBlock Style="{StaticResource DetailLabelStyle}"
                                           Foreground="{ThemeResource ToolboxTextSecondaryBrush}"
                                           Text="OS version" />
                                <TextBlock x:Name="DetailOsVersion"
                                           Style="{StaticResource DetailValueStyle}"
                                           Foreground="{ThemeResource ToolboxTextPrimaryBrush}"
                                           Text="—" />

                                <TextBlock Style="{StaticResource DetailLabelStyle}"
                                           Foreground="{ThemeResource ToolboxTextSecondaryBrush}"
                                           Text="Last logged-on user" />
                                <TextBlock x:Name="DetailLastUser"
                                           Style="{StaticResource DetailValueStyle}"
                                           Foreground="{ThemeResource ToolboxTextPrimaryBrush}"
                                           Text="—" />

                                <Grid ColumnSpacing="8" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource DetailLabelStyle}"
                                                   Foreground="{ThemeResource ToolboxTextSecondaryBrush}"
                                                   Text="LAPS" />
                                        <TextBlock x:Name="DetailLaps"
                                                   Style="{StaticResource DetailValueStyle}"
                                                   Foreground="{ThemeResource ToolboxTextPrimaryBrush}"
                                                   Margin="0"
                                                   Text="—" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Copy"
                                            VerticalAlignment="Bottom"
                                            Click="CopyLaps_Click" />
                                </Grid>

                                <Border Height="1" Background="{ThemeResource ToolboxDividerBrush}" Margin="0,4,0,12" />

                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
                                    <Ellipse x:Name="PingDot" Width="12" Height="12" Fill="{ThemeResource ToolboxSubtleFillBrush}" />
                                    <TextBlock x:Name="PingSummary"
                                               Text="Ping: —"
                                               Foreground="{ThemeResource ToolboxTextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="PingDetails"
                                           Style="{StaticResource MutedCaptionStyle}"
                                           Foreground="{ThemeResource ToolboxTextSecondaryBrush}"
                                           Margin="0,0,0,12"
                                           Text="" />

                                <ProgressRing x:Name="DetailProgress" Width="32" Height="32" IsActive="False" Visibility="Collapsed" Margin="0,0,0,12" />

                                <TextBlock Text="Remote tools"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource ToolboxTextPrimaryBrush}"
                                           Margin="0,4,0,8" />
                                <ComboBox x:Name="RemoteToolCombo" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                                <Button x:Name="RemoteButton"
                                        Content="Remote in"
                                        Style="{StaticResource ToolboxAccentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Click="RemoteButton_Click"
                                        Margin="0,0,0,8" />

                                <ItemsControl x:Name="DetailActionsHost">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <Button Content="Copy computer name"
                                        HorizontalAlignment="Stretch"
                                        Click="CopyComputerName_Click"
                                        Margin="0,8,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabViewItem>

            <TabViewItem x:Name="StreamingTab" Header="Streaming" IsClosable="False">
                <Border Margin="8,12,8,8"
                        Padding="20"
                        CornerRadius="8"
                        Background="{ThemeResource ToolboxCardBrush}"
                        BorderBrush="{ThemeResource ToolboxCardStrokeBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        MinWidth="320">
                    <StackPanel Spacing="12" MaxWidth="360">
                        <TextBlock Text="Streaming"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Foreground="{ThemeResource ToolboxTextPrimaryBrush}" />
                        <TextBlock Text="Select a streaming endpoint, then connect or open the web tools."
                                   Style="{StaticResource MutedCaptionStyle}"
                                   Foreground="{ThemeResource ToolboxTextSecondaryBrush}"
                                   TextWrapping="WrapWholeWords" />

                        <ComboBox x:Name="StreamingEndpointCombo"
                                  Header="Streaming PC"
                                  HorizontalAlignment="Stretch" />

                        <Button x:Name="StreamingConnectButton"
                                Content="Connect to PC"
                                Style="{StaticResource ToolboxAccentButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Click="StreamingConnectButton_Click" />
                        <Button x:Name="StreamingViewButton"
                                Content="View Stream"
                                HorizontalAlignment="Stretch"
                                Click="StreamingViewButton_Click" />
                        <Button x:Name="StreamingControlButton"
                                Content="Control App"
                                HorizontalAlignment="Stretch"
                                Click="StreamingControlButton_Click" />

                        <Border Height="1" Background="{ThemeResource ToolboxDividerBrush}" Margin="0,4" />

                        <TextBlock Text="Config"
                                   Style="{StaticResource MutedCaptionStyle}"
                                   Foreground="{ThemeResource ToolboxTextSecondaryBrush}" />
                        <Button x:Name="StreamingPasswordButton"
                                Content="Change Stream Password"
                                HorizontalAlignment="Stretch"
                                Click="StreamingPasswordButton_Click" />
                    </StackPanel>
                </Border>
            </TabViewItem>
        </TabView>

        <Border x:Name="StatusPanel"
                Grid.Row="2"
                Padding="16,8"
                Background="{ThemeResource ToolboxLayerBrush}"
                BorderBrush="{ThemeResource ToolboxDividerBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="72" />
                </Grid.RowDefinitions>
                <TextBlock Text="Status"
                           Style="{StaticResource MutedCaptionStyle}"
                           Foreground="{ThemeResource ToolboxTextSecondaryBrush}"
                           Margin="0,0,0,4" />
                <ListView x:Name="StatusList"
                          Grid.Row="1"
                          Background="Transparent"
                          Foreground="{ThemeResource ToolboxTextSecondaryBrush}"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:StatusLogEntry">
                            <TextBlock Text="{x:Bind Display}"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       Foreground="{ThemeResource ToolboxTextSecondaryBrush}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Window>
