<?xml version="1.0" encoding="utf-8"?>
<!--
  Styles that reference ThemeResource.
  Kept out of App.xaml — MarkupCompilePass1 reports WMC1005 when ThemeResource
  Style setters appear in the Application XAML file.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="ToolboxAccentButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ToolboxAccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Foreground" Value="{ThemeResource ToolboxTextPrimaryBrush}" />
    </Style>

    <Style x:Key="MutedCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource ToolboxTextSecondaryBrush}" />
    </Style>

    <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource ToolboxTextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <Style x:Key="DetailValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource ToolboxTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="ToolboxListViewStyle" TargetType="ListView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource ToolboxTextPrimaryBrush}" />
        <Setter Property="IsItemClickEnabled" Value="True" />
    </Style>

    <Style x:Key="ToolboxListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Foreground" Value="{ThemeResource ToolboxTextPrimaryBrush}" />
    </Style>
</ResourceDictionary>
