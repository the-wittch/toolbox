<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="Toolbox.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ToolboxPageBrush" Color="#FF1A1A1A" />
                    <SolidColorBrush x:Key="ToolboxLayerBrush" Color="#FF202020" />
                    <SolidColorBrush x:Key="ToolboxCardBrush" Color="#FF2C2C2C" />
                    <SolidColorBrush x:Key="ToolboxCardStrokeBrush" Color="#FF3F3F3F" />
                    <SolidColorBrush x:Key="ToolboxDividerBrush" Color="#FF404040" />
                    <SolidColorBrush x:Key="ToolboxSubtleFillBrush" Color="#FF5A5A5A" />
                    <SolidColorBrush x:Key="ToolboxTextPrimaryBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ToolboxTextSecondaryBrush" Color="#FFB3B3B3" />
                    <SolidColorBrush x:Key="ToolboxErrorBrush" Color="#FFFF99A4" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ToolboxPageBrush" Color="#FFF3F3F3" />
                    <SolidColorBrush x:Key="ToolboxLayerBrush" Color="#FFF9F9F9" />
                    <SolidColorBrush x:Key="ToolboxCardBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ToolboxCardStrokeBrush" Color="#FFE0E0E0" />
                    <SolidColorBrush x:Key="ToolboxDividerBrush" Color="#FFD0D0D0" />
                    <SolidColorBrush x:Key="ToolboxSubtleFillBrush" Color="#FF9E9E9E" />
                    <SolidColorBrush x:Key="ToolboxTextPrimaryBrush" Color="#FF1A1A1A" />
                    <SolidColorBrush x:Key="ToolboxTextSecondaryBrush" Color="#FF666666" />
                    <SolidColorBrush x:Key="ToolboxErrorBrush" Color="#FFC42B1C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="ToolboxPageBrush" Color="#FF000000" />
                    <SolidColorBrush x:Key="ToolboxLayerBrush" Color="#FF000000" />
                    <SolidColorBrush x:Key="ToolboxCardBrush" Color="#FF000000" />
                    <SolidColorBrush x:Key="ToolboxCardStrokeBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ToolboxDividerBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ToolboxSubtleFillBrush" Color="#FFC0C0C0" />
                    <SolidColorBrush x:Key="ToolboxTextPrimaryBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ToolboxTextSecondaryBrush" Color="#FFC0C0C0" />
                    <SolidColorBrush x:Key="ToolboxErrorBrush" Color="#FFFFFF00" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <SolidColorBrush x:Key="ToolboxAccentBrush" Color="#FF2F6F7E" />
            <SolidColorBrush x:Key="ToolboxAccentDarkBrush" Color="#FF1F4F5A" />

            <Style x:Key="ToolboxAccentButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource ToolboxAccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Padding" Value="12,6" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="MutedCaptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Opacity" Value="0.72" />
            </Style>

            <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Opacity" Value="0.7" />
                <Setter Property="Margin" Value="0,0,0,2" />
            </Style>

            <Style x:Key="DetailValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
