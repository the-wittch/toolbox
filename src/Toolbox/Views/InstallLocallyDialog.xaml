<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Toolbox.Views.InstallLocallyDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Install Toolbox on this PC"
    PrimaryButtonText="Install and open"
    SecondaryButtonText="Continue without installing"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <StackPanel Spacing="12" Width="480">
        <TextBlock TextWrapping="Wrap">
            Toolbox is running from a network folder. Install a copy for your account to start
            faster and get updates automatically:
        </TextBlock>

        <TextBlock x:Name="DestinationText"
                   FontFamily="{StaticResource ToolboxMonoFont}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   IsTextSelectionEnabled="True" />

        <TextBlock TextWrapping="Wrap" Opacity="0.75" FontSize="12">
            Files are checked against the release manifest while they are copied. A desktop shortcut
            is created and the installed copy opens when it is done. No administrator rights are needed.
        </TextBlock>

        <ProgressBar x:Name="InstallProgress"
                     Maximum="1"
                     Visibility="Collapsed"
                     AutomationProperties.Name="Installation progress" />

        <TextBlock x:Name="ErrorText"
                   Foreground="{ThemeResource ToolboxErrorBrush}"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
