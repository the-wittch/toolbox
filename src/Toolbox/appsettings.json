{
  "$schema": "https://json.schemastore.org/appsettings.json",
  "programTitle": "Toolbox",
  "theme": "System",
  // Leave false so each staff member gets the first-run dialog.
  // Set true here to skip the wizard for everyone on a shared install.
  "setupCompleted": false,
  "ldap": {
    // First-run prefills from these values. Replace example.com with your real OU
    // (e.g. OU=Workstations,DC=contoso,DC=com) to give staff an editable default.
    "rootOu": "OU=Computers,DC=example,DC=com",
    "pageSize": 1000,
    "propertiesToLoad": [ "cn", "description", "operatingSystem", "operatingSystemVersion" ],
    "computerObjectFilter": "(objectCategory=computer)",
    "nameAttribute": "cn",
    "descriptionAttribute": "description",
    "missingDescriptionLabel": "No description available"
  },
  "search": {
    // Shown on first-run as the suggested computer-name prefixes.
    "computerNamePrefixes": [ "PC-", "WS-" ],
    "presets": [
      { "id": "normal", "label": "Normal", "queryText": "" },
      { "id": "vpn", "label": "VPN Client", "queryText": "10." },
      { "id": "inactive", "label": "Inactive PCs", "queryText": "INACTIVE: " },
      { "id": "loggedIn", "label": "Logged In", "queryText": "Login: " },
      { "id": "loggedOut", "label": "Logged Out", "queryText": "Logout: " },
      { "id": "today", "label": "Today", "queryText": "{today:M/d/yyyy}" }
    ],
    "historyLimit": 50
  },
  "accessControl": {
    "enabled": false,
    "allowedGroups": [
      "HelpDesk Admins",
      "IT Support"
    ],
    "denyMessage": "Unable to open the program. You have insufficient privileges."
  },
  "ping": {
    "timeoutMs": 3000,
    "bufferSize": 32
  },
  "deployment": {
    // Published folder used for auto-update on close (usually a UNC path).
    // Prefills first-run; staff can change it. No-op if Toolbox is already
    // running from this same path.
    "updateSourcePath": "\\\\7jd-mon-fs1\\apps\\Toolbox",
    "autoUpdateOnClose": true
  },
  "streaming": {
    // When false or endpoints is empty, the Streaming tab is hidden.
    "enabled": true,
    "connectRemoteToolId": "sccm",
    "changePasswordUrl": "http://wowza.nycourts.gov/VirtualCourt/updatepassword2.php",
    "endpoints": [
      {
        "id": "st-jd7-1",
        "label": "ST-JD7-1",
        "computerName": "ST-JD7-1",
        "viewStreamUrl": "http://wowza.nycourts.gov/VirtualCourt/new/st-jd7/st-jd7-1",
        "controlAppUrl": "http://st-jd7-1:8888/tablet3?cols=4&layout=cycle&loop=1&noconfigure=1&pages=1&rows=3"
      },
      {
        "id": "st-jd7-2",
        "label": "ST-JD7-2",
        "computerName": "ST-JD7-2",
        "viewStreamUrl": "http://wowza.nycourts.gov/VirtualCourt/new/st-jd7/st-jd7-2",
        "controlAppUrl": "http://st-jd7-2:8888/tablet3?cols=4&layout=cycle&loop=1&noconfigure=1&pages=1&rows=3"
      }
    ]
  },
  "remoteTools": [
    {
      "id": "sccm",
      "label": "SCCM Remote Viewer",
      "enabled": true,
      "arguments": "{computerName}",
      "candidatePaths": [
        "C:\\Program Files (x86)\\ConfigMgr Console\\bin\\i386\\CmRcViewer.exe",
        "C:\\Program Files (x86)\\ConfigurationManager\\Console\\bin\\i386\\CmRcViewer.exe",
        "C:\\Program Files\\ConfigurationManager\\Console\\bin\\i386\\CmRcViewer.exe",
        "C:\\Program Files\\ConfigMgr Console\\bin\\i386\\CmRcViewer.exe"
      ]
    },
    {
      "id": "ora",
      "label": "Remote Assistance",
      "enabled": true,
      "arguments": "/offerRA {computerName}",
      "candidatePaths": [
        "C:\\Windows\\System32\\msra.exe"
      ],
      "preferAsDefault": true
    },
    {
      "id": "rdp",
      "label": "RDP",
      "enabled": true,
      "arguments": "/v:{computerName}",
      "candidatePaths": [
        "C:\\Windows\\System32\\mstsc.exe"
      ]
    },
    {
      "id": "remoteSupport",
      "label": "Remote Support Jump",
      "enabled": true,
      "arguments": "--run-script action=push_and_start_local&hostname={computerName}",
      "candidatePaths": [
        "C:\\Users\\{userName}\\AppData\\Local\\Bomgar\\bomgar-rep\\support.example.com\\Software\\bomgar-rep.exe",
        "C:\\Program Files\\Bomgar\\Bomgar Representative Console\\support.example.com\\bomgar-rep.exe",
        "C:\\Program Files\\Bomgar\\Representative Console\\support.example.com\\bomgar-rep.exe"
      ]
    }
  ],
  "detailActions": [
    {
      "id": "explorer",
      "label": "Open C$",
      "enabled": true,
      "requiresOnline": true,
      "executable": "explorer.exe",
      "arguments": "\\\\{computerName}\\c$"
    },
    {
      "id": "msinfo",
      "label": "System Information",
      "enabled": true,
      "requiresOnline": true,
      "executable": "msinfo32.exe",
      "arguments": "/computer {computerName}"
    }
  ],
  "labels": {
    "searchPlaceholder": "Computer name, description, or username",
    "searchButton": "Search",
    "remoteButton": "Remote in",
    "resultsEmpty": "No computers found. Try a different search.",
    "resultsHint": "Double-click a row for OS info and ping results.",
    "historyHeader": "Recent searches",
    "statusReady": "Ready",
    "loadingDetail": "Loading details…",
    "themeLight": "Light",
    "themeDark": "Dark",
    "themeSystem": "System"
  },
  "ui": {
    "windowWidth": 1180,
    "windowHeight": 720,
    "minWidth": 900,
    "minHeight": 560,
    "showSearchHistory": true,
    "showStatusLog": true,
    "statusLogLimit": 200
  }
}
